# perfpilot-mcp-playwright — standalone spin-up
# Copy this file to `.env` only if you need the optional cert env vars.
# The vendor Playwright image is fully driven by CLI flags in
# docker-compose.yml; nothing below is required for a basic run.

HTTP_PORT=8117

# Optional: test-user client certificate selection.
# The image bakes .p12 / .pem files from docker/certs/playwright/.
# CN filter and passphrase let the browser auto-select the right cert
# when a target site presents a mutual-TLS challenge.
# PLAYWRIGHT_CERT_PASSPHRASE=your_p12_passphrase
# PLAYWRIGHT_CERT_AUTO_SELECT_CN=TestUser1
