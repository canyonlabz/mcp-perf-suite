# perfpilot-mcp-perfmemory — standalone spin-up
# Copy this file to `.env` and fill in the embedding + Postgres values.

DEPLOYMENT_MODE=local
MCP_TRANSPORT=http
MCP_HTTP_PREFIX=/perfpilot-mcp-perfmemory
HTTP_PORT=8116

# --- Embedding provider (openai | azure_openai | ollama) ---
EMBEDDING_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (only if EMBEDDING_PROVIDER=azure_openai)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Ollama (only if EMBEDDING_PROVIDER=ollama)
# Inside Docker use host.docker.internal instead of localhost.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- PostgreSQL (pgvector + AGE) ---
# Standalone default is localhost. In the full-stack compose the value
# is `perfmem-pgvector-age` (the compose service name).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=perfmemory
POSTGRES_USER=perfadmin
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
# POSTGRES_SSLROOTCERT=
